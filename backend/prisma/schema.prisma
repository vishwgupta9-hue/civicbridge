// CivicBridge — Prisma Schema
// SIH PS 26043 — Community Problem-Solving Platform for Jharkhand
// Version: 2.1 (Corrected Schema — Pre-Migration)
// Database: PostgreSQL 15+ with pgvector extension

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

// =============================================================================
// ENUMS
// =============================================================================

/// User roles in the system. Five authenticated roles only.
enum Role {
  CITIZEN
  ADMIN
  UNIVERSITY
  INDUSTRY
  STARTUP
}

/// Institutional entity type. Separate from Role.
/// Extended in V3 to include GOVERNMENT for public departments/administrations.
enum OrganizationType {
  GOVERNMENT
  UNIVERSITY
  INDUSTRY
  STARTUP
}

/// Exactly 3 priority tiers derived from a single priority score (0.0 – 100.0).
/// Formula: (Severity×0.25) + (AffectedPeople×0.25) + (Frequency×0.15) + (Evidence×0.15) + (Urgency×0.20)
/// All five factors are normalized to 0–100 before applying weights.
enum PriorityTier {
  LOW // priorityScore 0.0 – 39.9
  MEDIUM // priorityScore 40.0 – 69.9
  HIGH // priorityScore 70.0 – 100.0
}

/// Parallel government trust signal. NOT a visibility or participation gate.
/// All problems with filterStatus = PASSED are visible to institutions
/// regardless of their verificationStatus.
enum VerificationStatus {
  AI_SCREENED // Default upon passing AI relevance filter
  GOVERNMENT_VERIFIED // Government reviewed and confirmed
  DECLINED_BY_GOVT // Government reviewed but declined (problem remains active)
}

/// Problem-solving lifecycle (independent of VerificationStatus and PriorityTier).
/// Child statuses (Proposal, BusinessConcept, Collaboration) do NOT automatically
/// promote or demote this status.
enum ProblemStatus {
  OPEN // Live in Problem Bank; institutions can act on it
  IN_PROGRESS // Active student project or startup venture underway
  RESOLVED // Completed solution delivered and confirmed
  CLOSED // Archived
}

/// AI relevance screening result for a submitted problem.
/// PENDING is the safe default: a problem is NOT visible to institutions until
/// the AI pipeline explicitly sets this to PASSED.
enum FilterStatus {
  PENDING // Initial state: AI screening not yet completed — problem NOT visible
  PASSED // AI screening passed — problem enters Problem Bank and is visible
  REJECTED // AI screening failed — problem not visible in Problem Bank
  FLAGGED // Requires manual admin review before entering Problem Bank
}

/// Type of institutional support offered by industry to a startup/problem.
/// NOTE: FUNDING is explicitly excluded per product decision.
enum SupportType {
  MENTORSHIP // Expertise and guidance
  TECHNICAL // Technical resources, tools, infrastructure
  PROTOTYPING // Lab access, manufacturing, testing
  GENERAL_INTEREST // Expressing broad interest without specific commitment
}

/// Stages in a startup's venture journey on a claimed problem.
enum VentureStage {
  PROBLEM_CLAIMED // Startup has claimed / expressed interest in the problem
  CONCEPT_SUBMITTED // BusinessConcept record submitted
  SUPPORT_REQUESTED // Startup has filed one or more SupportRequests
  SUPPORT_GRANTED // At least one SupportRequest approved
  BUILDING // Active development / solution building
  PILOTED // Pilot or proof-of-concept delivered
}

/// University proposal lifecycle. Independent of Problem.status.
enum ProposalStatus {
  SUBMITTED // Proposal submitted by university; awaiting admin review
  UNDER_REVIEW // Admin is reviewing the proposal
  ACCEPTED // Proposal accepted; work can begin
  IN_PROGRESS // Active work underway
  COMPLETED // Deliverables submitted and confirmed
  WITHDRAWN // University withdrew the proposal
}

/// Collaboration lifecycle status. Independent of Problem.status.
/// Upgraded in V3 to support the structured commitment model.
enum CollaborationStatus {
  // Legacy V2 statuses
  INTERESTED // Initial expression of interest / offer submitted
  ACTIVE // Collaboration actively underway
  COMPLETED // Collaboration concluded

  // V3 structured commitment statuses
  PROPOSED
  ACCEPTED
  IN_PROGRESS
  DELIVERED
  CONFIRMED
  DECLINED
  CANCELLED
}

/// V3 Project execution track type.
enum ProjectTrack {
  ACADEMIC_RESEARCH // University / R&D led
  COMMERCIAL_VENTURE // Startup / Business builder led
  CIVIC_INITIATIVE // Community / NGO / Multi-stakeholder led
}

/// V3 Project lifecycle status.
enum ProjectStatus {
  PLANNING
  BUILDING
  PILOTING
  COMPLETED
  ABANDONED
}

/// V3 Structured Milestone status.
enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  SUBMITTED
  VERIFIED
}

/// V3 Universal Offer and Need category.
enum OfferCategory {
  LAB_EQUIPMENT
  TESTING_ANALYSIS
  MANUFACTURING_FABRICATION
  FACILITY_SITE_ACCESS
  DOMAIN_EXPERTISE_MENTORSHIP
  HARDWARE_COMPONENTS
}

/// V3 Need urgency tier.
enum NeedUrgency {
  STANDARD
  CRITICAL_PATH
}

/// V3 Need resolution status.
enum NeedStatus {
  OPEN
  COMMITTED
  FULFILLED
  CANCELLED
}

/// V3 Field pilot lifecycle status.
enum PilotStatus {
  PROPOSED
  PREPARATION
  ACTIVE_ON_GROUND
  EVALUATION
  CONCLUDED
}

/// V3 Government administrative clearance workflow status (never auto-granted).
enum ClearanceStatus {
  NOT_REQUIRED
  REQUIRED
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  NEEDS_MORE_INFO
  GRANTED
  DECLINED
}

/// V3 Pilot verification finding.
enum VerificationFinding {
  SUCCESS_CONFIRMED
  PARTIAL_IMPROVEMENT
  NO_CHANGE
  FAILED
}

/// V3 Evidence documentation type.
enum EvidenceType {
  PHOTO_GEOTAG
  LAB_REPORT
  SENSOR_DATASET
  WRITTEN_INSPECTION
}

// =============================================================================
// MODELS
// =============================================================================

/// All authenticated users across all five roles.
model User {
  id           String @id @default(uuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role

  // Optional profile fields
  phone    String?
  district String?

  // Institutional link (for UNIVERSITY, INDUSTRY, STARTUP, and GOVERNMENT/ADMIN roles)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  // Relations
  problems         Problem[]        @relation("CitizenProblems")
  validations      Validation[]     @relation("AdminValidations")
  verifiedProblems Problem[]        @relation("AdminVerifications")
  progressUpdates  ProgressUpdate[]

  // V3 Pilot & Verification relations
  clearedPilots      PilotDeployment[]   @relation("AdminPilotClearances")
  recordedMetrics    PilotMetric[]       @relation("RecordedMetrics")
  verifiedMetrics    PilotMetric[]       @relation("VerifiedMetrics")
  pilotVerifications PilotVerification[] @relation("UserPilotVerifications")

  // Civic Social platform relations
  comments           ProblemComment[]
  reactions          ProblemReaction[]
  evidenceUpdates    ProblemEvidenceUpdate[]
  notifications      Notification[]          @relation("UserNotifications")
  actorNotifications Notification[]          @relation("ActorNotifications")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([email])
}

/// Institutional entity representing Government, University, Industry, or Startup.
model Organization {
  id   String           @id @default(uuid())
  name String
  type OrganizationType // GOVERNMENT, UNIVERSITY, INDUSTRY, or STARTUP

  // Registration / identification codes
  regCode String? // AICTE/UGC for University; CIN for Industry; DPIIT for Startup; Dept Code for Govt

  // Domain and expertise tags used for AI matching
  domainTags    String[]
  expertiseTags String[]

  district     String?
  state        String  @default("Jharkhand")
  contactEmail String
  contactPhone String?

  // Relations
  users            User[]
  proposals        Proposal[]
  businessConcepts BusinessConcept[]
  collaborations   Collaboration[]   @relation("IndustryCollaborations")

  // V3 Relations
  projects               Project[]
  offers                 Offer[]
  needs                  Need[]
  providedCollaborations Collaboration[] @relation("ProvidedCollaborations")
  receivedCollaborations Collaboration[] @relation("ReceivedCollaborations")
  verifiedMilestones     Milestone[]     @relation("MilestoneVerifications")

  responsiblePilots  PilotDeployment[]   @relation("ResponsiblePilots")
  pilotVerifications PilotVerification[] @relation("OrgPilotVerifications")

  // Industry & Solution Partner Capabilities & Proposals
  companyType         String?
  industryCategories  String[]                     @default([])
  certifications      String[]                     @default([])
  deploymentCapacity  String?
  locationsServed     String[]                     @default([])
  caseStudies         String?                      @db.Text
  capabilities        IndustryCapability[]
  deploymentProposals IndustryDeploymentProposal[]

  createdAt DateTime @default(now())

  @@index([type])
}

/// A civic problem submitted by an authenticated Citizen.
///
/// Visibility rule:
///   filterStatus = PASSED  →  visible to all institutions.
///   filterStatus = PENDING | REJECTED | FLAGGED  →  NOT visible.
///
/// verificationStatus is a parallel trust signal only. It does NOT control
/// whether institutions can view or act on a problem.
model Problem {
  id            String  @id @default(uuid())
  title         String
  description   String  @db.Text
  category      String // e.g. "Water & Sanitation", "Rural Roads", "Education"
  subCategory   String?
  district      String // One of 24 Jharkhand districts
  locationText  String?
  latitude      Float?
  longitude     Float?
  affectedCount Int     @default(1)
  evidenceUrl   String? // Photo or PDF storage URL
  videoUrl      String? // Optional video link or secondary evidence URL

  // --- Solution Lifecycle (independent of verification and priority) ---
  status ProblemStatus @default(OPEN)

  // --- AI Relevance Screening ---
  // Default is PENDING: problem is NOT visible until AI pipeline sets PASSED.
  filterStatus FilterStatus @default(PENDING)
  filterReason String?

  // --- Single Priority Metric ---
  // Formula: (Severity×0.25)+(AffectedPeople×0.25)+(Frequency×0.15)+(Evidence×0.15)+(Urgency×0.20)
  // All factors normalized 0–100. Score range: 0.0–100.0.
  // Default 0.0 / LOW until AI pipeline or admin sets the real values.
  priorityScore Float        @default(0.0)
  priorityTier  PriorityTier @default(LOW)

  // --- Parallel Government Trust Signal (NOT a visibility gate) ---
  verificationStatus    VerificationStatus @default(AI_SCREENED)
  verificationNotes     String?            @db.Text
  verifiedAt            DateTime?
  verifiedById          String? // FK to User (Admin who verified)
  verifiedBy            User?              @relation("AdminVerifications", fields: [verifiedById], references: [id])
  verificationRequested Boolean            @default(false)

  // --- Submitter (authenticated Citizen, required) ---
  submittedById String
  submittedBy   User   @relation("CitizenProblems", fields: [submittedById], references: [id])

  // --- Subsystem Relations ---
  aiAnalysis       AIAnalysis?
  validation       Validation?
  proposals        Proposal[]
  businessConcepts BusinessConcept[]
  collaborations   Collaboration[]
  supportRequests  SupportRequest[]
  projectProblems  ProjectProblem[]
  pilots           PilotDeployment[]

  // Civic Social Platform Relations
  comments        ProblemComment[]
  reactions       ProblemReaction[]
  evidenceUpdates ProblemEvidenceUpdate[]
  notifications   Notification[]

  // Industry Solutions & Deployment Proposals
  industryProposals IndustryDeploymentProposal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filterStatus])
  @@index([status])
  @@index([verificationStatus])
  @@index([priorityTier])
  @@index([district])
  @@index([category])
}

/// AI analysis record for a problem. 1:1 with Problem, cascade-deleted.
///
/// Stores:
///   - AI classification output (category, confidence)
///   - Five normalized priority factor scores (0–100 each) for the approved formula
///   - Raw AI urgency signal (1–10 scale, separate from the normalized urgency factor)
///   - Duplicate detection results
///   - pgvector semantic embedding
model AIAnalysis {
  id        String  @id @default(uuid())
  problemId String  @unique
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  // AI classification
  predictedCategory String
  confidenceScore   Float // 0.0 – 1.0 (AI's classification confidence)

  // AI narrative output
  aiSummary String @db.Text

  // --- Five normalized priority factor scores (0–100 each) ---
  // Used to compute: (Severity×0.25)+(AffectedPeople×0.25)+(Frequency×0.15)+(Evidence×0.15)+(Urgency×0.20)
  severityScore       Int // Weight: 25% — how harmful or dangerous the problem is
  affectedPeopleScore Int // Weight: 25% — scale of population affected
  frequencyScore      Int // Weight: 15% — how often the problem occurs
  evidenceScore       Int // Weight: 15% — quality and quantity of supporting evidence
  urgencyScore        Int // Weight: 20% — normalized urgency (0–100, derived from aiUrgencyScore)

  // Raw AI urgency signal (1–10 scale from LLM output), retained for auditability.
  // Stored separately for auditability. urgencyScore above is the normalized 0–100 version.
  aiUrgencyScore  Int // 1 – 10 (raw LLM urgency assessment)
  aiUrgencyReason String @db.Text

  // --- Duplicate Detection ---
  isDuplicate         Boolean  @default(false)
  duplicateSimilarity Float? // Cosine similarity score of the closest match (0.0–1.0)
  similarProblemIds   String[] // UUIDs of potential duplicate problems

  // pgvector embedding for semantic search and duplicate detection (1536-dim, e.g. text-embedding-3-small)
  embedding Unsupported("vector(1536)")?

  // --- Problem DNA & Root-Cause Hypotheses ---
  rootCauseHypotheses String[] @default([])
  requiredExpertise   String[] @default([])
  departmentHints     String[] @default([])

  createdAt DateTime @default(now())
}

/// Government admin validation record. Stores the five factor scores and the
/// final trust decision. The recalculated result is written only to
/// Problem.priorityScore; this model does not persist a second priority score.
/// 1:1 with Problem, cascade-deleted.
/// Does NOT gate institutional access; Problem.filterStatus controls visibility.
model Validation {
  id        String  @id @default(uuid())
  problemId String  @unique
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  reviewedById String
  reviewedBy   User   @relation("AdminValidations", fields: [reviewedById], references: [id])

  // Five normalized factor scores (0–100 each) — admin's assessment
  // Formula: (severityScore×0.25)+(affectedScore×0.25)+(frequencyScore×0.15)+(evidenceScore×0.15)+(urgencyScore×0.20)
  severityScore  Int // Weight: 25%
  affectedScore  Int // Weight: 25%
  frequencyScore Int // Weight: 15%
  evidenceScore  Int // Weight: 15%
  urgencyScore   Int // Weight: 20%

  // Government's trust decision (does NOT gate institutional access)
  decision   VerificationStatus // GOVERNMENT_VERIFIED or DECLINED_BY_GOVT
  remarks    String?            @db.Text
  reviewedAt DateTime           @default(now())
}

/// University proposal for solving a civic problem.
/// Multiple proposals can exist for the same problem (different universities).
/// ProposalStatus is independent of Problem.status.
model Proposal {
  id           String       @id @default(uuid())
  problemId    String
  problem      Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  universityId String
  university   Organization @relation(fields: [universityId], references: [id])

  facultyMentor    String
  teamMembers      Json // [{ name, email, rollNo, role }]
  proposedApproach String   @db.Text
  deliverables     String   @db.Text
  timelineStart    DateTime
  timelineEnd      DateTime
  milestones       Json // [{ title, deadline, status }]
  budgetRequired   Float?

  // Proposal's own lifecycle (independent of Problem.status)
  status ProposalStatus @default(SUBMITTED)

  progressUpdates ProgressUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([problemId])
  @@index([universityId])
  @@index([status])
}

/// Startup's business concept for solving a civic problem.
/// Multiple concepts can exist for the same problem simultaneously.
/// VentureStage is independent of Problem.status.
model BusinessConcept {
  id        String       @id @default(uuid())
  problemId String
  problem   Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  startupId String
  startup   Organization @relation(fields: [startupId], references: [id])

  solutionDescription String  @db.Text
  targetBeneficiaries String  @db.Text
  marketSize          String?
  businessModel       String  @db.Text
  revenueModel        String  @db.Text
  sustainabilityModel String  @db.Text

  // Venture's own lifecycle stage (independent of Problem.status)
  currentStage VentureStage @default(PROBLEM_CLAIMED)

  supportRequests SupportRequest[]
  progressUpdates ProgressUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([problemId])
  @@index([startupId])
}

/// Support request filed by a startup, directed at Government, University, or Industry.
/// Linked to both BusinessConcept and Problem for full context.
model SupportRequest {
  id                String          @id @default(uuid())
  businessConceptId String
  businessConcept   BusinessConcept @relation(fields: [businessConceptId], references: [id], onDelete: Cascade)
  problemId         String
  problem           Problem         @relation(fields: [problemId], references: [id])

  requestedFrom Role // ADMIN (Government), UNIVERSITY, or INDUSTRY
  requestType   String // "Mentorship", "Lab Testing", "Scheme Referral", etc.
  details       String @db.Text

  // Support request's own status (independent of BusinessConcept stage)
  status        String  @default("PENDING") // PENDING | APPROVED | REJECTED
  responseNotes String?

  createdAt DateTime @default(now())
}

/// Collaboration model upgraded for V3 structured commitments.
/// Preserves legacy V2 fields for seamless backwards compatibility.
model Collaboration {
  id String @id @default(uuid())

  // --- V3 Structured Commitment Fields ---
  needId         String?
  need           Need?         @relation(fields: [needId], references: [id], onDelete: SetNull)
  offerId        String?
  offer          Offer?        @relation(fields: [offerId], references: [id], onDelete: SetNull)
  providerOrgId  String?
  providerOrg    Organization? @relation("ProvidedCollaborations", fields: [providerOrgId], references: [id])
  recipientOrgId String?
  recipientOrg   Organization? @relation("ReceivedCollaborations", fields: [recipientOrgId], references: [id])
  projectId      String?
  project        Project?      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  contributionScope      String?   @db.Text
  expectedCompletionDate DateTime?
  proofDocumentUrl       String?
  completionNotes        String?   @db.Text
  completedAt            DateTime?

  // --- Legacy V2 Fields (preserved with non-null constraints for V2 compatibility) ---
  problemId   String?
  problem     Problem?      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  industryId  String?
  industry    Organization? @relation("IndustryCollaborations", fields: [industryId], references: [id])
  supportType SupportType?  @default(GENERAL_INTEREST)
  message     String?       @default("") @db.Text

  status CollaborationStatus @default(INTERESTED)

  milestones      Milestone[]
  progressUpdates ProgressUpdate[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([needId])
  @@index([offerId])
  @@index([providerOrgId])
  @@index([recipientOrgId])
  @@index([projectId])
  @@index([problemId])
  @@index([industryId])
  @@index([status])
}

/// Progress update log for a Proposal, BusinessConcept, or V3 Project / Milestone / Collaboration.
model ProgressUpdate {
  id                String           @id @default(uuid())
  proposalId        String?
  proposal          Proposal?        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  businessConceptId String?
  businessConcept   BusinessConcept? @relation(fields: [businessConceptId], references: [id], onDelete: Cascade)

  // V3 Project & Milestone & Collaboration relations
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId     String?
  milestone       Milestone?      @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  collaborationId String?
  collaboration   Collaboration?  @relation(fields: [collaborationId], references: [id], onDelete: Cascade)

  updateText     String  @db.Text
  milestoneTitle String?
  attachmentUrl  String?

  postedById String
  postedBy   User   @relation(fields: [postedById], references: [id])

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([milestoneId])
  @@index([collaborationId])
}

// =============================================================================
// V3 DOMAIN MODELS (Projects, Milestones, Needs, Offers, Pilots, Verifications)
// =============================================================================

/// V3 Project: The unified execution container replacing separate Proposal / BusinessConcept.
model Project {
  id                String        @id @default(uuid())
  title             String
  executiveSummary  String        @db.Text
  technicalApproach String        @db.Text
  trackType         ProjectTrack
  status            ProjectStatus @default(PLANNING)

  leadOrgId String
  leadOrg   Organization @relation(fields: [leadOrgId], references: [id])

  // Structured metadata per track (Academic: mentor, student team; Commercial: business/revenue model)
  trackMetadata Json?

  // Relations
  problems        ProjectProblem[]
  milestones      Milestone[]
  needs           Need[]
  collaborations  Collaboration[]
  pilots          PilotDeployment[]
  progressUpdates ProgressUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([leadOrgId])
  @@index([trackType])
  @@index([status])
}

/// Explicit join model for Many-to-Many Project ↔ Problem relationship.
/// Enables a Project to address multiple clustered problems across wards/districts.
model ProjectProblem {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  problemId String
  problem   Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  isPrimary Boolean  @default(true)
  linkedAt  DateTime @default(now())

  @@unique([projectId, problemId])
  @@index([projectId])
  @@index([problemId])
}

/// V3 Structured Milestone: Relational tracking with deadlines, deliverables, and verifications.
model Milestone {
  id               String          @id @default(uuid())
  projectId        String?
  project          Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  collaborationId  String?
  collaboration    Collaboration?  @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  title            String
  description      String          @db.Text
  responsibleParty String?
  targetDate       DateTime
  status           MilestoneStatus @default(PENDING)

  deliverableUrl  String?
  verifiedByOrgId String?
  verifiedByOrg   Organization? @relation("MilestoneVerifications", fields: [verifiedByOrgId], references: [id])
  verifiedAt      DateTime?

  needs           Need[]
  progressUpdates ProgressUpdate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([collaborationId])
  @@index([status])
}

/// V3 Universal Offer: Any Organization (Gov, Uni, Startup, Industry) can publish capabilities.
model Offer {
  id             String        @id @default(uuid())
  providerOrgId  String
  providerOrg    Organization  @relation(fields: [providerOrgId], references: [id])
  category       OfferCategory
  title          String
  specifications String        @db.Text
  district       String? // Specific district or "STATEWIDE"
  capacityTerms  String?       @db.Text
  status         String        @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED

  collaborations Collaboration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerOrgId])
  @@index([category])
  @@index([district])
  @@index([status])
}

/// V3 Need: Demand for resources, equipment, testing, or site access.
/// Can exist independently or optionally attach to a Project / Milestone.
model Need {
  id           String       @id @default(uuid())
  creatorOrgId String
  creatorOrg   Organization @relation(fields: [creatorOrgId], references: [id])
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId  String?
  milestone    Milestone?   @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  category OfferCategory
  title    String
  details  String        @db.Text
  district String?
  urgency  NeedUrgency   @default(STANDARD)
  status   NeedStatus    @default(OPEN)

  collaborations Collaboration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([creatorOrgId])
  @@index([projectId])
  @@index([milestoneId])
  @@index([category])
  @@index([status])
}

/// V3 Field Pilot Deployment: Physical testbed on the ground.
model PilotDeployment {
  id                     String    @id @default(uuid())
  projectId              String
  project                Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  problemId              String?
  problem                Problem?  @relation(fields: [problemId], references: [id], onDelete: SetNull)
  responsibleOrgId       String?
  responsibleOrg         Organization? @relation("ResponsiblePilots", fields: [responsibleOrgId], references: [id], onDelete: SetNull)

  title                  String
  description            String?   @db.Text
  risksRequirements      String?   @db.Text
  siteLocation           String
  district               String
  latitude               Float?
  longitude              Float?
  targetBeneficiaryCount Int       @default(0)
  actualBeneficiaryCount Int?
  startDate              DateTime?
  endDate                DateTime?
  actualStartDate        DateTime?
  actualEndDate          DateTime?

  // Government administrative clearance workflow (never auto-granted)
  clearanceStatus      ClearanceStatus @default(NOT_REQUIRED)
  clearanceDocumentUrl String? // Uploaded official administrative permission letter / NOC
  clearanceNotes       String?         @db.Text
  clearanceRequestedAt DateTime?
  clearanceDecidedAt   DateTime?
  clearedById          String?
  clearedBy            User?           @relation("AdminPilotClearances", fields: [clearedById], references: [id])

  status PilotStatus @default(PROPOSED)

  evidenceDocumentUrl String?

  metrics       PilotMetric[]
  verifications PilotVerification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([problemId])
  @@index([responsibleOrgId])
  @@index([district])
  @@index([clearanceStatus])
  @@index([status])
}

/// V3 Granular Quantitative Metric for Pilots (baseline vs outcome measurements).
model PilotMetric {
  id      String          @id @default(uuid())
  pilotId String
  pilot   PilotDeployment @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  metricName    String
  unit          String
  baselineValue Float
  targetValue   Float?
  outcomeValue  Float?
  status        String          @default("REPORTED") // REPORTED | VERIFIED

  evidenceUrl   String?
  recordedById  String
  recordedBy    User            @relation("RecordedMetrics", fields: [recordedById], references: [id])
  recordedAt    DateTime        @default(now())

  verifiedById  String?
  verifiedBy    User?           @relation("VerifiedMetrics", fields: [verifiedById], references: [id])
  verifiedAt    DateTime?

  @@index([pilotId])
  @@index([status])
}

/// V3 Qualitative and Multi-Stakeholder Ground-Truth Verification for Pilots.
model PilotVerification {
  id      String          @id @default(uuid())
  pilotId String
  pilot   PilotDeployment @relation(fields: [pilotId], references: [id], onDelete: Cascade)

  verifierId       String
  verifier         User          @relation("UserPilotVerifications", fields: [verifierId], references: [id])
  verificationRole Role?
  organizationId   String?
  organization     Organization? @relation("OrgPilotVerifications", fields: [organizationId], references: [id])

  finding      VerificationFinding
  evidenceType EvidenceType
  evidenceUrl  String?
  feedbackText String?             @db.Text
  verifiedAt   DateTime            @default(now())

  @@index([pilotId])
  @@index([verifierId])
  @@index([organizationId])
  @@index([finding])
}

// =============================================================================
// CIVIC SOCIAL PLATFORM MODELS
// =============================================================================

/// Civic social reactions on problems (Affected Me, Support/Upvote, Follow)
enum ReactionType {
  AFFECTED
  SUPPORT
  FOLLOW
}

model ProblemReaction {
  id        String       @id @default(uuid())
  problemId String
  problem   Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ReactionType
  createdAt DateTime     @default(now())

  @@unique([userId, problemId, type])
  @@index([problemId])
  @@index([userId])
  @@index([type])
}

/// Community discussion and threaded comments on civic problems
model ProblemComment {
  id           String           @id @default(uuid())
  problemId    String
  problem      Problem          @relation(fields: [problemId], references: [id], onDelete: Cascade)
  authorId     String
  author       User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentId     String?
  parent       ProblemComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies      ProblemComment[] @relation("CommentReplies")
  content      String           @db.Text
  isReported   Boolean          @default(false)
  reportReason String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([problemId])
  @@index([authorId])
  @@index([parentId])
}

/// Additional photo evidence and community timeline updates
model ProblemEvidenceUpdate {
  id            String   @id @default(uuid())
  problemId     String
  problem       Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  submittedById String
  submittedBy   User     @relation(fields: [submittedById], references: [id], onDelete: Cascade)
  title         String
  description   String   @db.Text
  photoUrl      String?
  videoUrl      String?
  createdAt     DateTime @default(now())

  @@index([problemId])
  @@index([submittedById])
}

/// Civic notification alerts for citizens and stakeholders
enum NotificationType {
  COMMENT
  REPLY
  STATUS_CHANGE
  GOVERNMENT_VERIFIED
  SOLUTION_PROPOSED
  EVIDENCE_UPDATE
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?            @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  type      NotificationType
  problemId String?
  problem   Problem?         @relation(fields: [problemId], references: [id], onDelete: Cascade)
  title     String
  message   String           @db.Text
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

// =============================================================================
// INDUSTRY & SOLUTION PARTNER MODELS
// =============================================================================

/// Capability types published by Industry & Solution Partners
enum CapabilityType {
  PRODUCT
  SERVICE
  EQUIPMENT_FACILITY
  TECHNICAL_EXPERTISE
}

/// Catalog of real industrial products, services, facilities, equipment, and expertise
model IndustryCapability {
  id              String                       @id @default(uuid())
  organizationId  String
  organization    Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type            CapabilityType
  title           String
  description     String                       @db.Text
  category        String // Manufacturing, Engineering, Testing Laboratories, etc.
  specifications  Json? // Technical specs, capacity, use cases, location
  availability    String                       @default("AVAILABLE") // AVAILABLE, SCHEDULED, UPON_REQUEST
  locationsServed String[]                     @default([])
  caseStudies     String?                      @db.Text
  proposals       IndustryDeploymentProposal[]
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  @@index([organizationId])
  @@index([type])
  @@index([category])
  @@index([availability])
}

/// Tailored Industry Capability & Deployment Proposal for a specific civic problem
model IndustryDeploymentProposal {
  id                     String              @id @default(uuid())
  problemId              String
  problem                Problem             @relation(fields: [problemId], references: [id], onDelete: Cascade)
  organizationId         String
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  capabilityId           String?
  capability             IndustryCapability? @relation(fields: [capabilityId], references: [id], onDelete: SetNull)

  // Focused Capability / Deployment Proposal Fields
  providedItems          String              @db.Text // What the company provides
  technicalCapability    String              @db.Text // Technical capability
  relevantProductService String?             @db.Text // Relevant product/service
  previousDeployment     String?             @db.Text // Previous deployment
  deploymentRequirements String?             @db.Text // Deployment requirements
  expectedTimeline       String // Expected timeline (e.g. "4-6 Weeks")
  estimatedCost          String? // Estimated cost / CSR commitment
  expectedCivicImpact    String              @db.Text // Expected civic impact
  status                 String              @default("SUBMITTED") // SUBMITTED, UNDER_REVIEW, ACCEPTED, DEPLOYED, DECLINED

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([problemId])
  @@index([organizationId])
  @@index([capabilityId])
  @@index([status])
}
